      "loader_form": {"policy_mode": "strict", "constraints": [], "scopes": [{"match": "/work/alice", "principal": "alice", "engagement": "alice-research", "allow_telemetry_egress": false}], "principals": [{"principal": "alice", "os_user": 501, "require_scope": true, "allowances": [{"period": "month", "amount": {"currency": "GBP", "micros": 50000000}, "timezone": "Europe/London"}]}], "allow_private_hosts": false, "refuse_on_pii": true, "record_internal_prefixes": ["https://rag.example.internal/"], "terms": [{"host": "library.example", "reference": "firm/library-subscription", "requires_reporting": true, "access_context": [{"scheme": "ror", "value": "https://ror.org/000000000"}]}]}
    },

    {
      "name": "a misspelled top-level field",
      "policy": {"policy_mode": "strict", "contraints": [{"kind": "access_rule", "host": "*", "action": "refuse"}]},
      "schema_valid": false,
      "accepted": false,
      "check": "structure"
    },
    {
      "name": "a misspelled scope field",
      "policy": {"scopes": [{"match": "/matters", "engagment": "matters"}]},
      "schema_valid": false,
      "accepted": false,
      "check": "structure"
    },
    {
      "name": "a scope without a match",
      "policy": {"scopes": [{"engagement": "matters"}]},
      "schema_valid": false,
      "accepted": false,
      "check": "structure"
    },
    {
      "name": "an unknown policy mode",
      "policy": {"policy_mode": "enforce"},
      "schema_valid": false,
      "accepted": false,
      "check": "structure"
    },
    {
      "name": "an unknown constraint kind",
      "policy": {"constraints": [{"kind": "allowed_domain", "host": "docs.example"}]},
      "schema_valid": false,
      "accepted": false,
      "check": "structure"
    },
    {
      "name": "an access rule with no action",
      "policy": {"constraints": [{"kind": "access_rule", "host": "docs.example"}]},
      "schema_valid": false,
      "accepted": false,
      "check": "structure"
    },
    {
      "name": "a value of the wrong type",
      "policy": {"allow_private_hosts": "no"},
      "schema_valid": false,
      "accepted": false,
      "check": "structure"
    },
    {
      "name": "a fractional token cap",
      "policy": {"constraints": [{"kind": "maximum_context_tokens", "tokens": 1.5}]},
      "schema_valid": false,
      "accepted": false,
      "check": "structure"
    },
    {
      "name": "an unknown member inside an amount",
      "policy": {"constraints": [{"kind": "maximum_acquisition_cost", "amount": {"currency": "GBP", "micros": 1, "note": "per page"}}]},
      "schema_valid": false,
      "accepted": false,
      "check": "structure"
    },
    {
      "name": "a wildcard that does not stand at the front of a host pattern",
      "policy": {"constraints": [{"kind": "access_rule", "host": "docs.*.example", "action": "allow"}]},
      "schema_valid": true,
      "accepted": false,
      "check": "structure"
    },

    {
      "name": "a recordable prefix that is not an absolute URL",
      "policy": {"record_internal_prefixes": ["rag.example.internal/"]},
      "schema_valid": true,
      "accepted": false,
      "check": "internal_prefix_not_absolute",
      "refusal": "policy.json: record_internal_prefixes entry \"rag.example.internal/\" is not an absolute URL prefix and would never match anything"
    },
    {
      "name": "a recordable prefix without a trailing slash",
      "policy": {"record_internal_prefixes": ["https://rag.example.internal"]},
      "schema_valid": true,
      "accepted": false,
      "check": "internal_prefix_unterminated",
      "refusal": "policy.json: record_internal_prefixes entry \"https://rag.example.internal\" must end with \"/\" — without it the prefix also matches hosts and paths it merely starts, which would record more than the operator named"
    },
    {
      "name": "a scope with an empty match",
      "policy": {"scopes": [{"match": ""}]},
      "schema_valid": true,
      "accepted": false,
      "check": "scope_match_empty",
      "refusal": "policy.json has a scope with an empty \"match\", which would govern everything"
    },
    {
      "name": "two scopes with one match",
      "policy": {"scopes": [{"match": "/matters", "policy_mode": "strict"}, {"match": "/matters", "policy_mode": "observe"}]},
      "schema_valid": true,
      "accepted": false,
      "check": "scope_match_duplicate",
      "refusal": "policy.json declares two scopes matching \"/matters\"; only the first would govern or take an edit, so the second must be merged into it or renamed"
    },
    {
      "name": "a principal with an empty name",
      "policy": {"principals": [{"principal": "", "os_user": 501}]},
      "schema_valid": true,
      "accepted": false,
      "check": "principal_name_empty",
      "refusal": "policy.json has a principal with an empty name"
    },
    {
      "name": "one principal declared twice",
      "policy": {"principals": [{"principal": "alice", "os_user": 501}, {"principal": "alice", "os_user": 502}]},
      "schema_valid": true,
      "accepted": false,
      "check": "principal_name_duplicate",
      "refusal": "policy.json declares principal \"alice\" twice, for OS users 501 and 502"
    },
    {
      "name": "one operating-system user bound to two principals",
      "policy": {"principals": [{"principal": "alice", "os_user": 501}, {"principal": "bob", "os_user": 501}]},
      "schema_valid": true,
      "accepted": false,
      "check": "principal_os_user_duplicate",
      "refusal": "policy.json binds OS user 501 to both \"alice\" and \"bob\"; one identity cannot hold two principals"
    },
    {
      "name": "a principal required to work in a scope that no scope is bound to",
      "policy": {"principals": [{"principal": "alice", "os_user": 501, "require_scope": true}]},
      "schema_valid": true,
      "accepted": false,
      "check": "principal_scope_missing",
      "refusal": "policy.json requires principal \"alice\" to work in a directory scope bound to it and declares none, so nothing could ever be admitted for it; bind a scope or drop require_scope"
    },
    {
      "name": "an allowance in a timezone the build does not know",
      "policy": {"principals": [{"principal": "alice", "os_user": 501, "allowances": [{"period": "day", "amount": {"currency": "GBP", "micros": 1000000}, "timezone": "Europe/Atlantis"}]}]},
      "schema_valid": true,
      "accepted": false,
      "check": "allowance_timezone_unknown",
      "refusal": "policy.json principal \"alice\" day allowance names timezone \"Europe/Atlantis\", which is not an IANA zone this build recognises"
    },
    {
      "name": "two allowances for one period",
      "policy": {"principals": [{"principal": "alice", "os_user": 501, "allowances": [{"period": "day", "amount": {"currency": "GBP", "micros": 1000000}, "timezone": "UTC"}, {"period": "day", "amount": {"currency": "GBP", "micros": 2000000}, "timezone": "UTC"}]}]},
      "schema_valid": true,
      "accepted": false,
      "check": "allowance_period_duplicate",
      "refusal": "policy.json principal \"alice\" declares two day allowances of 1.000000 and 2.000000; one period holds one amount, and the second would silently never bind"
    },
    {
      "name": "a require_licence rule naming no licence",
      "policy": {"constraints": [{"kind": "access_rule", "host": "library.example", "action": "require_licence", "licence": " "}]},
      "schema_valid": true,
      "accepted": false,
      "check": "access_rule_licence_empty",
      "refusal": "policy.json the top-level policy constraint 1: a require_licence access rule must name the licence it requires"
    },
    {
      "name": "a require_licence rule naming no licence, inside a scope",
