      "schema_valid": true,
      "accepted": false,
      "check": "access_rule_licence_empty",
      "refusal": "policy.json scope \"/matters\" constraint 2: a require_licence access rule must name the licence it requires"
    },
    {
      "name": "a scope with an empty engagement",
      "policy": {"scopes": [{"match": "/matters", "engagement": ""}]},
      "schema_valid": true,
      "accepted": false,
      "check": "scope_engagement_empty",
      "refusal": "policy.json has a scope with an empty \"engagement\""
    },
    {
      "name": "telemetry egress cleared without an engagement",
      "policy": {"scopes": [{"match": "/matters", "allow_telemetry_egress": true}]},
      "schema_valid": true,
      "accepted": false,
      "check": "scope_egress_without_engagement",
      "refusal": "policy.json scope \"/matters\" allows telemetry egress without naming an engagement"
    },
    {
      "name": "a scope bound to a principal that is not declared",
      "policy": {"scopes": [{"match": "/work/alice", "principal": "alice"}]},
      "schema_valid": true,
      "accepted": false,
      "check": "scope_principal_undeclared",
      "refusal": "policy.json scope \"/work/alice\" names undeclared principal \"alice\""
    },
    {
      "name": "terms naming no host",
      "policy": {"terms": [{"host": "", "reference": "firm/library-subscription"}]},
      "schema_valid": true,
      "accepted": false,
      "check": "terms_host_empty",
      "refusal": "policy.json the top-level policy terms entry 1 names no host"
    },
    {
      "name": "terms naming no reference",
      "policy": {"terms": [{"host": "library.example", "reference": " "}]},
      "schema_valid": true,
      "accepted": false,
      "check": "terms_reference_empty",
      "refusal": "policy.json the top-level policy terms entry 1 for host \"library.example\" names no reference; the reference is what the record and the wire carry"
    },
    {
      "name": "two agreements for one host, spelled differently",
      "policy": {"scopes": [{"match": "/matters", "terms": [{"host": "library.example", "reference": "firm/library-subscription"}, {"host": "Library.Example", "reference": "firm/library-trial"}]}]},
      "schema_valid": true,
      "accepted": false,
      "check": "terms_host_duplicate",
      "refusal": "policy.json scope \"/matters\" declares terms for host \"library.example\" twice; one host holds one agreement"
    },
    {
      "name": "an institution identifier without a value",
      "policy": {"terms": [{"host": "library.example", "reference": "firm/library-subscription", "access_context": [{"scheme": "ror", "value": ""}]}]},
      "schema_valid": true,
      "accepted": false,
      "check": "terms_identifier_incomplete",
      "refusal": "policy.json the top-level policy terms entry 1 for host \"library.example\" has an access_context identifier without a scheme or a value"
    }
  ],
