      "accepted": true,
      "loader_form": {"policy_mode": "observe", "constraints": [{"kind": "access_rule", "host": "*.docs.example.com", "action": "refuse"}, {"kind": "access_rule", "host": "xn--bcher-kva.example", "action": "allow"}, {"kind": "maximum_acquisition_cost", "amount": {"currency": "GBP", "micros": 2500000}}], "scopes": [], "allow_private_hosts": false, "record_internal_prefixes": []}
    },
    {
      "name": "an unknown member inside a constraint is dropped, not refused",
      "policy": {"constraints": [{"kind": "denied_source_host", "host": "tracker.example", "note": "advertising"}, {"kind": "access_rule", "host": "*", "action": "refuse", "reason": "default"}]},
      "schema_valid": true,
      "accepted": true,
      "loader_form": {"policy_mode": "observe", "constraints": [{"kind": "denied_source_host", "host": "tracker.example"}, {"kind": "access_rule", "host": "*", "action": "refuse"}], "scopes": [], "allow_private_hosts": false, "record_internal_prefixes": []}
    },
    {
      "name": "an explicit null on a scope's optional field is the field left out",
      "policy": {"scopes": [{"match": "/research", "policy_mode": null, "constraints": null, "engagement": null}]},
      "schema_valid": true,
      "accepted": true,
      "loader_form": {"policy_mode": "observe", "constraints": [], "scopes": [{"match": "/research", "allow_telemetry_egress": false}], "allow_private_hosts": false, "record_internal_prefixes": []}
    },
    {
      "name": "a scope that replaces every setting it may",
      "policy": {"policy_mode": "observe", "scopes": [{"match": "/matters", "engagement": "matters", "allow_telemetry_egress": true, "policy_mode": "strict", "constraints": [{"kind": "access_rule", "host": "*", "action": "require_mediation"}], "allow_private_hosts": true, "refuse_on_pii": true, "terms": [{"host": "library.example", "reference": "firm/library-subscription"}]}]},
      "schema_valid": true,
      "accepted": true,
      "loader_form": {"policy_mode": "observe", "constraints": [], "scopes": [{"match": "/matters", "engagement": "matters", "allow_telemetry_egress": true, "policy_mode": "strict", "constraints": [{"kind": "access_rule", "host": "*", "action": "require_mediation"}], "allow_private_hosts": true, "refuse_on_pii": true, "terms": [{"host": "library.example", "reference": "firm/library-subscription", "requires_reporting": false}]}], "allow_private_hosts": false, "record_internal_prefixes": []}
    },
    {
      "name": "principals, allowances, terms and recordable prefixes",
      "policy": {"policy_mode": "strict", "principals": [{"principal": "alice", "os_user": 501, "require_scope": true, "allowances": [{"period": "month", "amount": {"currency": "GBP", "micros": 50000000}, "timezone": "Europe/London"}]}], "scopes": [{"match": "/work/alice", "principal": "alice", "engagement": "alice-research"}], "terms": [{"host": "library.example", "reference": "firm/library-subscription", "requires_reporting": true, "access_context": [{"scheme": "ror", "value": "https://ror.org/000000000"}]}], "record_internal_prefixes": ["https://rag.example.internal/"], "refuse_on_pii": true},
      "schema_valid": true,
