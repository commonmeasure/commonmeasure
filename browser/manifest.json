{
  "manifest_version": 3,
  "name": "Common Measure",
  "version": "0.4.1",
  "description": "Records the sources ChatGPT answers, Google AI Overviews and Bing Copilot Search show, as observed crossings in the local Common Measure record.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.uk/search*"
      ],
      "js": ["google.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.bing.com/search*",
        "https://bing.com/search*",
        "https://www.bing.com/copilotsearch*",
        "https://bing.com/copilotsearch*"
      ],
      "js": ["bing.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Common Measure"
  }
}
