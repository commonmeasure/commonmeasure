# Every credential the adapters read, blank. Leave a line blank to leave that
# provider unconfigured; the runtime records the absence and never guesses.
# Copy to .env (gitignored) and fill in; never commit a value.
DATAVILLE_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
TOLLBIT_API_KEY=
TOLLBIT_AGENT_ID=
TOLLBIT_AGENT_ORG=
TOLLBIT_AGENT_STRING=
REDPINE_API_KEY=
PARALLEL_API_KEY=
LINKUP_API_KEY=
SEARCH1API_API_KEY=
SERPDIVE_API_KEY=
KEENABLE_API_KEY=
YOU_API_KEY=
NIMBLE_API_KEY=
OZONE_LIVE_API_KEY=
TINYFISH_API_KEY=
OPENAI_API_KEY=

# TensorZero's OpenAI-compatible Chat Completions endpoint. Start the committed
# sidecar before a run; a missing or unreachable endpoint stays unavailable.
COMMONMEASURE_INFERENCE_ENDPOINT=http://127.0.0.1:3000/openai/v1/chat/completions

# Direct OpenRouter: set the endpoint above to
# https://openrouter.ai/api/v1/chat/completions and export exactly one of the
# following settings. Do not export both; the example is not loaded automatically.
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_FILE=
